{
  "name": "KeycardPal",
  "version": "1.12.0",
  "private": true,
  "scripts": {
    "android": "ONLINE_BUILD=true react-native run-android --mode fullDebug",
    "android:offline": "react-native run-android --mode offlineDebug",
    "ios": "set -a; [ -f .env ] && . ./.env; set +a; react-native run-ios",
    "lint": "eslint .",
    "lint:android": "cd android && ./gradlew ktlintCheck",
    "lint:ios": "cd ios && swiftlint lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "start": "ONLINE_BUILD=true react-native start",
    "start:offline": "react-native start",
    "test": "jest",
    "postinstall": "npx react-native-asset",
    "bump": "node scripts/bump-version.js",
    "smoke": "node scripts/smoke-release.js",
    "generate:abi": "node scripts/generate-abi.js",
    "generate:selectors": "node scripts/generate-selectors.js",
    "generate:tokens": "node scripts/generate-tokens.js",
    "generate:chains": "node scripts/generate-chains.js",
    "generate:logos": "node scripts/generate-logos.js",
    "generate:logos:clean": "node scripts/generate-logos.js --clean",
    "generate": "npm run generate:tokens && npm run generate:chains && npm run generate:abi && npm run generate:selectors",
    "check:offline-bundle": "node scripts/check-offline-bundle.js",
    "check:bundles": "node scripts/check-bundles.js",
    "check:ios-bundle": "node scripts/check-ios-bundle.js",
    "check:offline-apk": "node scripts/check-offline-apk.js"
  },
  "dependencies": {
    "@ethereumjs/rlp": "^10.1.1",
    "@keystonehq/bc-ur-registry": "^0.7.1",
    "@keystonehq/bc-ur-registry-eth": "^0.22.1",
    "@ngraveio/bc-ur": "^1.1.13",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@react-native/new-app-screen": "^0.87.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.13.0",
    "@reown/walletkit": "1.2.10",
    "@scure/base": "^2.0.0",
    "@scure/bip32": "^2.0.1",
    "@scure/bip39": "^2.0.1",
    "@walletconnect/core": "2.21.7",
    "@walletconnect/react-native-compat": "2.21.8",
    "bitcoinjs-lib": "^6.1.7",
    "fast-text-encoding": "1.0.6",
    "keycard-sdk": "^4.0.1",
    "node-libs-react-native": "^1.2.1",
    "react": "^19.2.0",
    "react-native": "^0.87.1",
    "react-native-animated-ur-qr": "^0.1.5",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keycard": "github:mmlado/react-native-keycard#73190849a4776eaa5c021cd4039234f6b3f012e4",
    "react-native-paper": "^5.15.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.3",
    "slip39": "^0.1.9",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.29.5",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/text-encoding": "^0.0.40",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-asset": "^2.2.14",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.35.4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "fast-xml-parser": "^5.8.0",
    "uuid": "^11.1.1",
    "@walletconnect/utils": {
      "viem": "$viem"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
