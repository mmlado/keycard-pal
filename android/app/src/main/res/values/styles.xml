<resources>

    <!-- Base application theme. React Native's edge-to-edge setup overrides the
         system bar colours at runtime, so none are set here. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <!-- Launch theme: the window the system shows from process start until the
         React root has mounted. MainActivity swaps it for AppTheme through
         `postSplashScreenTheme`. -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:navigationBarDividerColor">@color/app_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
